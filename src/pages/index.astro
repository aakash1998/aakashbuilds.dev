---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import VoiceTimeline from '../components/VoiceTimeline.astro';
import { LINKS, notes, heroFlow, platformFlow, ragFlow } from '../data/site';
import '../styles/global.css';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aakash Patel',
  jobTitle: 'Senior Data Engineer',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Calgary',
    addressCountry: 'CA',
  },
  sameAs: [LINKS.linkedin, LINKS.github],
};

const voiceSteps = [
  { title: 'User speaks', sub: '0 ms' },
  { title: 'speech recognition' },
  { title: 'partial transcript' },
  { title: 'LLM inference' },
  { title: 'first tokens' },
  { title: 'speech synthesis' },
  { title: 'audio response' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <Head
      title="Aakash Patel — Senior Data Engineer"
      description="I build data systems that have to be right — data platforms and production AI where correctness, latency, reliability and cost are the engineering problem."
      path="/"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />

    <main id="main">
      <!-- ============ HERO ============ -->
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="hero-meta">Senior Data Engineer · Calgary</p>
            <h1 id="hero-title">I build data systems that have to be right.</h1>
            <p class="hero-sub">I design and operate data platforms and production AI systems where correctness, latency, reliability and cost are part of the engineering problem.</p>
            <p class="hero-career">Cuesta Partners · previously Citi and Avenue Living</p>
            <div class="hero-links">
              <a class="tlink tlink--down" href="#work">View selected work <span class="arr" aria-hidden="true">↓</span></a>
              <a class="tlink" href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arr" aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="hero-visual">
            <FlowDiagram items={heroFlow} label="How I think about a data system" compact />
          </div>
        </div>
      </section>

      <!-- ============ PROJECT 01 (light) ============ -->
      <section class="showcase" id="work" aria-labelledby="p01-title">
        <div class="wrap showcase-grid">
          <div class="showcase-copy">
            <p class="kicker"><span class="n">01</span> · Data Platform</p>
            <h3 id="p01-title">35% faster pipelines. ~20% lower compute cost.</h3>
            <p class="showcase-desc">Redesigned orchestration and compute across Microsoft Fabric and Databricks for a production data platform serving finance and operational workloads.</p>
            <div class="metric-row">
              <div><p class="metric-num">35%</p><p class="metric-label">faster execution</p></div>
              <div><p class="metric-num">~20%</p><p class="metric-label">lower compute cost</p></div>
              <div><p class="metric-num">50+</p><p class="metric-label">stakeholders</p></div>
            </div>
            <a class="tlink" href="/work/data-platform">View case study <span class="arr" aria-hidden="true">→</span></a>
          </div>
          <div class="showcase-visual">
            <FlowDiagram items={platformFlow} label="Data platform — simplified architecture" />
          </div>
        </div>
      </section>

      <!-- ============ PROJECT 02 (dark) ============ -->
      <section class="showcase showcase--dark showcase--flip" aria-labelledby="p02-title">
        <div class="wrap showcase-grid">
          <div class="showcase-copy">
            <p class="kicker"><span class="n">02</span> · Production AI</p>
            <h3 id="p02-title">AI answers are easy. Trust is the engineering problem.</h3>
            <p class="showcase-desc">An enterprise assistant answering tax and HR questions from internal documents. Retrieval quality, re-ranking, grounding and evaluation mattered more than the chat interface.</p>
            <a class="tlink" href="/work/enterprise-ai">View case study <span class="arr" aria-hidden="true">→</span></a>
          </div>
          <div class="showcase-visual">
            <FlowDiagram items={ragFlow} label="RAG pipeline — retrieval before generation" dark />
          </div>
        </div>
      </section>

      <!-- ============ PROJECT 03 (light, timeline) ============ -->
      <section class="showcase showcase--timeline" aria-labelledby="p03-title">
        <div class="wrap showcase-grid">
          <div class="showcase-copy">
            <p class="kicker"><span class="n">03</span> · Real-time AI</p>
            <h3 id="p03-title">In voice systems, latency is product quality.</h3>
            <p class="showcase-desc">Speech recognition, inference and synthesis were orchestrated asynchronously because every unnecessary pause makes the product feel broken.</p>
            <a class="tlink" href="/work/voice-ai">View case study <span class="arr" aria-hidden="true">→</span></a>
          </div>
          <div class="showcase-visual">
            <VoiceTimeline steps={voiceSteps} label="Voice pipeline — stages overlap instead of waiting" />
          </div>
        </div>
      </section>

      <!-- ============ ENGINEERING NOTES ============ -->
      <section class="section notes-section" id="notes" aria-labelledby="notes-title">
        <div class="wrap">
          <h2 class="section-title" id="notes-title">Engineering Notes</h2>
          <div>
            {notes.slice(0, 3).map((note) => (
              <a class="note-row" href={note.url} target="_blank" rel="noopener">
                <span class="note-num">{note.index}</span>
                <span>
                  <span class="note-title">{note.title}</span>
                  <span class="note-meta" style="display:block;margin-top:0.5rem">{note.category} · {note.date}</span>
                </span>
                <span class="note-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          <p class="notes-more">
            <a class="tlink" href="/notes">View all notes <span class="arr" aria-hidden="true">→</span></a>
          </p>
        </div>
      </section>

      <!-- ============ EXPERIENCE ============ -->
      <section class="section" id="experience" aria-labelledby="xp-title">
        <div class="wrap">
          <h2 class="section-title" id="xp-title">Experience</h2>
          <ol class="xp">
            <li>
              <span class="xp-date">2026 — now</span>
              <div>
                <p class="xp-co">Cuesta Partners</p>
                <p class="xp-role">Senior Data Engineer</p>
                <p class="xp-scope">Data platforms and engineering systems across consulting engagements.</p>
              </div>
            </li>
            <li>
              <span class="xp-date">2025 — 2026</span>
              <div>
                <p class="xp-co">Avenue Living</p>
                <p class="xp-role">Data Engineer</p>
                <p class="xp-scope">Fabric, Databricks and production AI for finance and operational data.</p>
              </div>
            </li>
            <li>
              <span class="xp-date">2022 — 2025</span>
              <div>
                <p class="xp-co">Citi</p>
                <p class="xp-role">Data Engineer</p>
                <p class="xp-scope">Distributed Azure data pipelines for financial datasets.</p>
              </div>
            </li>
          </ol>
          <p class="edu-line"><strong>Education</strong> — MSc Big Data Analytics, Trent University · BEng Computer Engineering</p>
        </div>
      </section>

      <!-- ============ ABOUT ============ -->
      <section class="section" id="about" aria-labelledby="about-title">
        <div class="wrap about-grid">
          <div class="about-copy">
            <h2 class="section-title" id="about-title">About</h2>
            <p>I care about the parts of engineering that only become visible once people depend on a system: reconciliation, failure recovery, schema changes, observability, latency and cost. I work across data platforms and production AI, with an emphasis on systems that remain understandable and reliable after they ship.</p>
            <p class="about-personal">Based in Calgary. Currently at Cuesta Partners; previously Citi and Avenue Living.</p>
          </div>
        </div>
      </section>

      <!-- ============ CONTACT (dark) ============ -->
      <section class="section contact--dark" aria-labelledby="contact-title">
        <div class="wrap">
          <h2 class="contact-title" id="contact-title">Have a hard data problem?</h2>
          <p><a class="tlink contact-email" href={'mailto:' + LINKS.email}>{LINKS.email} <span class="arr" aria-hidden="true">↗</span></a></p>
          <div class="contact-rows">
            <a class="tlink" href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arr" aria-hidden="true">↗</span></a>
            <a class="tlink" href={LINKS.github} target="_blank" rel="noopener">GitHub <span class="arr" aria-hidden="true">↗</span></a>
            <span>Calgary, Canada</span>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
