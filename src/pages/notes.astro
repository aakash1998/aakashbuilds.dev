---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { notes } from '../data/site';
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <Head
      title="Engineering Notes — Aakash Patel"
      description="Short notes on production data engineering: reconciliation, data quality, cost, and what breaks when AI hits production."
      path="/notes"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header base="/" />

    <main id="main">
      <section class="section" aria-labelledby="notes-title" style="padding-top: clamp(3rem, 7vw, 5rem)">
        <div class="wrap">
          <p class="kicker">Index</p>
          <h1 class="section-title" id="notes-title" style="margin-bottom: 1rem">Engineering Notes</h1>
          <p style="color: var(--secondary); max-width: 36rem; margin-bottom: 3rem">Short notes on what production teaches you. New ones land on LinkedIn.</p>
          <div>
            {notes.map((note) => (
              <a class="note-row" href={note.url} target="_blank" rel="noopener">
                <span class="note-num">{note.index}</span>
                <span>
                  <span class="note-title">{note.title}</span>
                  <span class="note-meta" style="display:block;margin-top:0.5rem">{note.category} · {note.date}</span>
                  {note.description && <span class="note-desc" style="display:block">{note.description}</span>}
                </span>
                <span class="note-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
