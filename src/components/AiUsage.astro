---
const snapshot = {
  reportedOn: '2026-10-05',
  museReset: '2026-10-05',
  chatgptDay: '2026-10-04',
  museLimit: 100_000_000,
  musePercent: 48,
  chatgptTokens: 33_300_000,
};
const museUsed = snapshot.museLimit * snapshot.musePercent / 100;
const museRemaining = snapshot.museLimit - museUsed;
const millions = (value: number) => (value / 1_000_000).toLocaleString('en-CA', { maximumFractionDigits: 1 });
---
<section class="section usage-section" id="ai-usage" aria-labelledby="usage-title">
  <div class="wrap">
    <div class="usage-heading">
      <div>
        <p class="kicker">Personal workflow · Usage snapshot</p>
        <h2 id="usage-title">Building with AI.</h2>
      </div>
      <p class="usage-date">Reported <time datetime={snapshot.reportedOn}>05 Oct 2026</time></p>
    </div>
    <p class="usage-intro">A snapshot of the AI tools I use while building, researching and solving engineering problems.</p>
    <div class="usage-grid">
      <article class="usage-card" aria-labelledby="muse-usage-title">
        <p class="usage-period">Current weekly allowance</p>
        <h3 id="muse-usage-title">Meta Muse</h3>
        <p class="usage-value">{millions(museUsed)}<span>M tokens used</span></p>
        <div class="usage-track" role="progressbar" aria-label="Meta Muse weekly token allowance used" aria-valuemin="0" aria-valuemax="100" aria-valuenow={snapshot.musePercent} aria-valuetext="48 million of 100 million tokens used, 48 percent">
          <span style={`width: ${snapshot.musePercent}%`}></span>
        </div>
        <div class="usage-scale"><span>{snapshot.musePercent}% used</span><span>{millions(snapshot.museLimit)}M limit</span></div>
        <p class="usage-detail">{millions(museRemaining)}M remaining · Reset <time datetime={snapshot.museReset}>05 Oct 2026</time></p>
      </article>
      <article class="usage-card" aria-labelledby="chatgpt-usage-title">
        <p class="usage-period">Single-day activity</p>
        <h3 id="chatgpt-usage-title">ChatGPT</h3>
        <p class="usage-value">{millions(snapshot.chatgptTokens)}<span>M tokens</span></p>
        <p class="usage-day"><time datetime={snapshot.chatgptDay}>04 Oct 2026</time></p>
        <p class="usage-detail">Reported daily usage. No allowance percentage supplied.</p>
      </article>
    </div>
    <p class="usage-footnote">Self-reported figures, updated manually. Muse shows weekly allowance usage; ChatGPT shows one day. These periods are different and are not combined into a total.</p>
  </div>
</section>

<style>
  .usage-section { border-top: 1px solid var(--border); }
  .usage-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .usage-heading h2 { font-size: clamp(2.25rem, 4.2vw, 2.75rem); }
  .usage-heading .kicker { margin-bottom: 1rem; }
  .usage-date, .usage-period, .usage-scale, .usage-day { font-family: var(--mono); font-size: .75rem; color: var(--secondary); }
  .usage-intro { color: var(--secondary); max-width: 40rem; margin: 1.5rem 0 2.5rem; }
  .usage-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--border); }
  .usage-card { padding: clamp(1.5rem, 3vw, 2.5rem); min-width: 0; }
  .usage-card + .usage-card { border-left: 1px solid var(--border); }
  .usage-period { margin-bottom: 1rem; }
  .usage-card h3 { font-size: 1.4rem; margin-bottom: 1.75rem; }
  .usage-value { font-family: var(--display); font-size: clamp(3rem, 6vw, 4.5rem); line-height: 1; letter-spacing: -.04em; font-variant-numeric: tabular-nums; margin-bottom: 1.75rem; }
  .usage-value span { display: block; font-family: var(--mono); font-size: .8rem; letter-spacing: 0; color: var(--secondary); margin-top: .75rem; line-height: 1.5; }
  .usage-track { height: 8px; background: var(--border); overflow: hidden; }
  .usage-track span { display: block; height: 100%; background: var(--accent); }
  .usage-scale { display: flex; justify-content: space-between; gap: 1rem; margin-top: .75rem; }
  .usage-detail { font-size: .85rem; color: var(--secondary); margin-top: 1.5rem; }
  .usage-day { border-top: 1px solid var(--border); padding-top: .75rem; }
  .usage-footnote { font-size: .8rem; color: var(--secondary); max-width: 49rem; margin-top: 1.25rem; }
  @media (max-width: 640px) {
    .usage-grid { grid-template-columns: 1fr; }
    .usage-card + .usage-card { border-left: 0; border-top: 1px solid var(--border); }
  }
</style>
