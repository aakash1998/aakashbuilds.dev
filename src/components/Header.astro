---
import { LINKS } from '../data/site';
interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={base + '#top'} aria-label="Aakash Patel — back to top">Aakash Patel</a>
    <nav class="site-nav" aria-label="Primary">
      <a href={base + '#work'}>Work</a>
      <a href={base + '#notes'}>Notes</a>
      <a href={base + '#about'}>About</a>
    </nav>
    <div class="header-ext">
      <a class="tlink" href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn <span class="arr" aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>
